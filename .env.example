# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where consultation requests are delivered (the studio owner's inbox)
CONTACT_TO_EMAIL=owner@yourstudio.com

# Optional: verified sender. Until your domain is verified in Resend, use
# onboarding@resend.dev (it can only deliver to your own Resend account email).
CONTACT_FROM_EMAIL="Studio Website <onboarding@resend.dev>"

# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.yourstudio.com

# --- GitHub Pages / static hosting only -------------------------------------
# Set automatically by .github/workflows/deploy-pages.yml; only needed for a
# local `npm run build:pages`.
# NEXT_PUBLIC_BASE_PATH=/your-repo-name
# Static hosting has no server, so the form posts here instead of /api/contact
# (e.g. a Formspree form endpoint).
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx
